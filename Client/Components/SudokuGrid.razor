@implements IDisposable
@inject GameStateService GameState
@using SudokuApp.Models
@namespace SudokuApp.Components

<div class="w-full px-4">
    <div class="grid w-full max-w-[22.5rem] mx-auto border-2 border-gray-800"
         style="grid-template-columns: repeat(@Puzzle.Config.Size, 1fr);">
        @for (int row = 0; row < Puzzle.Config.Size; row++)
        {
            for (int col = 0; col < Puzzle.Config.Size; col++)
            {
                <SudokuCell IsGiven="@Puzzle.GivenCells[row][col]"
                            Value="@Puzzle.Board[row][col]"
                            Row="@row"
                            Col="@col"
                            Config="@Puzzle.Config" />
            }
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public SudokuPuzzle Puzzle { get; set; } = default!;

    protected override void OnInitialized()
    {
        GameState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        GameState.OnChange -= StateHasChanged;
    }
}
