@namespace SudokuApp.Components
@using SudokuApp.Models

<div class="w-full px-4">
    <div class="grid w-full max-w-[22.5rem] mx-auto border-2 border-gray-800"
         style="grid-template-columns: repeat(@Config.Size, 1fr);">
        @for (int row = 0; row < Config.Size; row++)
        {
            for (int col = 0; col < Config.Size; col++)
            {
                var borderRight = (col + 1) % Config.BoxWidth == 0 && col < Config.Size - 1
                    ? "border-r-2 border-r-gray-800"
                    : "border-r border-r-gray-300";

                var borderBottom = (row + 1) % Config.BoxHeight == 0 && row < Config.Size - 1
                    ? "border-b-2 border-b-gray-800"
                    : "border-b border-b-gray-300";

                <div class="aspect-square w-full flex items-center justify-center bg-white @borderRight @borderBottom">
                    <div class="w-6 h-6 rounded bg-gray-200 animate-pulse"></div>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public GridConfig Config { get; set; } = new GridConfig { BoxWidth = 3, BoxHeight = 3 };
}
